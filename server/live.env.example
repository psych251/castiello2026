# Template for the DEPLOYED chat service's settings. Copy it to server/.env.<your Firebase
# project id> (that file is gitignored) once the lab confirms the access, and fill it in.
# No secrets go here: an API key goes into Firebase's secret store instead (see the handoff).
# Firebase reads this file when you deploy; the local emulators use server/.env.local instead.

CHAT_MODEL_PROVIDER=gemini

# The exact, pinned model version, e.g. a stable id from https://ai.google.dev/gemini-api/docs/models
# (not a "-latest" alias, which can change underneath the study). Recorded with every reply.
CHAT_MODEL_ID=

# How the lab gives access: api_key (Gemini Developer API, paid tier) or vertex (Vertex AI).
CHAT_GEMINI_ACCESS=

# Vertex AI only: the Google Cloud project id that holds the lab's credits, and its region.
CHAT_VERTEX_PROJECT=
CHAT_VERTEX_LOCATION=
